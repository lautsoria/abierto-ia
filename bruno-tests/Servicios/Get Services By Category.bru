meta {
  name: Get Services By Category
  type: http
  seq: 2
}

get {
  url: {{base_url}}/servicios/categoria/Plomería
  body: none
  auth: none
}

tests {
  test("Status code is 200", function() {
    expect(res.status).to.equal(200);
  });
  
  test("Response is an array", function() {
    expect(res.body).to.be.an('array');
  });
  
  test("All services are from Plomería category", function() {
    res.body.forEach(service => {
      expect(service.categoria).to.equal('Plomería');
    });
  });
}
